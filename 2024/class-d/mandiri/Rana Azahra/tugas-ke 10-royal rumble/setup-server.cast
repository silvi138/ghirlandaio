[0.003, "o", "\u001b[?25l\u001b[?2031h\u001b[>4;2m\u001b(B\u001b[m\u001b[94mversion\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[92m\"3.7\"\u001b(B\u001b[m\u001b[K\r\n\u001b[94mservices\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[K\r\n    \u001b[94mdb\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n        \u001b[94mimage\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m mysql:5.7\u001b[K\r\n        \u001b[94mrestart\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m always\u001b[K\r\n        \u001b[94mnetworks\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[K\r\n            \u001b[94mslims-net\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n                \u001b[94mipv4_address\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m 172.18.1.3\u001b[K\r\n        \u001b[94mcontainer_name\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m slims-db\u001b[K\r\n        \u001b[94menv_file\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[K\r\n            \u001b(B\u001b[0;1m-\u001b(B\u001b[m db_default.env\u001b[K\r\n        \u001b[94mcommand\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m --sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION --max_allowed_packet=1024M\u001b[K\r\n        \u001b[94mvolumes\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n            \u001b(B\u001b[0;1m-\u001b(B\u001b[m \u001b[92m\"./dbdata:/var/lib/mysql\"\u001b(B\u001b[m\u001b[K\r\n        #ports:\u001b[K\r\n        #    - \"3306:3306\"\u001b[K\r\n    \u001b[94mredis\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n        \u001b[94mimage\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m redis:latest\u001b[K\r\n        \u001b[94mrestart\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m always\u001b[K\r\n        \u001b[94mnetworks\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[K\r\n            \u001b[94mslims-net\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n                \u001b[94mipv4_address\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m 172.18.1.4\u001b[K\r\n        \u001b[94mcontainer_name\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m redis\u001b[K\r\n        #ports:\u001b[K\r\n        #    - \"6379:6379\"\u001b[K\r\n    \u001b[94mapp01\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n        \u001b[94mimage\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m slimsofficial/slims:latest\u001b[K\r\n        \u001b[94mrestart\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m always\u001b[K\r\n        \u001b[94mnetworks\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[K\r\n            \u001b[94mslims-net\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n                \u001b[94mipv4_address\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m 172.18.1.11\u001b[K\r\n        \u001b[94mcontainer_name\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m slims-app\u001b[K\r\n        \u001b[94mports\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n            \u001b(B\u001b[0;1m-\u001b(B\u001b[m \u001b[92m\"80:80\"\u001b(B\u001b[m\u001b[K\r\n            \u001b(B\u001b[0;1m-\u001b(B\u001b[m \u001b[92m\"443:443\"\u001b(B\u001b[m\u001b[K\r\n        \u001b[94mvolumes\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n            \u001b(B\u001b[0;1m-\u001b(B\u001b[m \u001b[92m\"./app:/var/www/html\"\u001b(B\u001b[m\u001b[K\r\n            \u001b(B\u001b[0;1m-\u001b(B\u001b[m \u001b[92m\"./conf/php/php.ini:/usr/local/etc/php/conf.d/php.ini\"\u001b(B\u001b[m\u001b[K\r\n\u001b[94mnetworks\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[K\r\n    \u001b[94mslims-net\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m\u001b[K\r\n        \u001b[94mname\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m slims-net\u001b[K\r\n\u001b(B\u001b[0;7mdocker-compose.yaml                                                                                                                                                            1,1            Top\u001b(B\u001b[m\r\n\u001b[J\u001b[2 q\u001b[2 q\u001b[H\u001b[94mversion\u001b(B\u001b[m\u001b[96m:\u001b(B\u001b[m \u001b[92m\"