[0.004, "o", "\u001b[1;34m::\u001b[0;1m There are 3 providers available for initramfs:\r\n\u001b[0m\u001b[1;34m::\u001b[0;1m Repository \u001b[1;35mcore\r\n\u001b[0m\u001b[0;1m  \u001b[0m 1) mkinitcpio\r\n\u001b[1;34m::\u001b[0;1m Repository \u001b[1;35mextra\r\n\u001b[0m\u001b[0;1m  \u001b[0m 2) booster  3) dracut\r\n\r\nEnter a number (default=1): \r\n"]
[0.009, "o", "\u001b[1;34m::\u001b[0;1m There are 3 providers available for oci-runtime:\r\n\u001b[0m\u001b[1;34m::\u001b[0;1m Repository \u001b[1;35mextra\r\n\u001b[0m\u001b[0;1m  \u001b[0m 1) crun  2) krun  3) runc\r\n\r\nEnter a number (default=1): \r\n"]
