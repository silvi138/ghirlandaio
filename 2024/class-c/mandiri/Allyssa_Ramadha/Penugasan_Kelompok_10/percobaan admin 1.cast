[0.002, "o", "\u001b[1;2H Config\u001b[30m\u001b[103mu\u001b[m\u000fration file for locale-gen\u001b[2;2H\u001b[14X\n lists of locales that are to be generated by the locale-gen command.\u001b[4;2H\u001b[13X\n Each line is of the form:\u001b[6;2H\u001b[13X\n     <locale> <charset>\u001b[8;2H\u001b[18X\n  where <locale> is one of the locales given in /\u001b[30m\u001b[103mu\u001b[m\u000fsr/share/i18n/locales\u001b[10;2H  and <charset> is one of the character sets listed in /\u001b[30m\u001b[103mu\u001b[m\u000fsr/share/i18n/charmaps\u001b[11;2H\u001b[11X\n  The locale-gen command will generate all the locales,\u001b[13;2H  placing them in /\u001b[30m\u001b[103mu\u001b[m\u000fsr/lib/locale.\u001b[14;2H\u001b[18X\n  A list of s\u001b[30m\u001b[103mu\u001b[m\u000fpported locales is given in /\u001b[30m\u001b[103mu\u001b[m\u000fsr/share/i18n/SUPPORTED\u001b[16;2H  and is incl\u001b[30m\u001b[103mu\u001b[m\u000fded in this file. Uncomment the needed locales below.\u001b[17;2H\u001b[13X\naa_DJ.UTF-8 UTF-8  \u001b[19;2Haa_DJ ISO-8859-1     \u001b[20;2Haa_ER\u001b[21;2Haa_ET UTF-8  \u001b[6X\u001b[22;2Haf_ZA.UTF-8 UTF-8  \u001b[23;2Haf_ZA ISO-8859-1  \u001b[24;2Hagr_PE UTF-8  \u001b[25;2Hak_GH\u001b[26;2Ham_ET UTF-8  \u001b[6X\u001b[27;2Han_ES.UTF-8 UTF-8  \u001b[28;2Han_ES ISO-8859-15     \u001b[29;2Hanp_IN UTF-8  \u001b[30;2Har_AE.UTF-8 UTF-8  \u001b[31;2Har_AE ISO-8859-6\u001b[32;2Har_BH.UTF-8 UTF-8  \u001b[5X\u001b[33;2Har_BH ISO-8859-6   \u001b[34;2Har_DZ.UTF-8 UTF-8  \u001b[35;2Har_DZ ISO-8859-6  \u001b[36;2Har_EG.UTF-8 UTF-8  \u001b[37;2Har_EG ISO-8859-6   \u001b[38;2Har_IN UTF-8  \u001b[5X\u001b[39;2Har_IQ\u001b[40;2Har_IQ ISO-8859-6  \u001b[41;2Har_JO.UTF-8 UTF-8  \u001b[42;2Har_JO ISO-8859-6  \u001b[43;2Har_KW.UTF-8 UTF-8  \u001b[44;2Har_KW ISO-8859-6  \u001b[45;2Har_LB.UTF-8 UTF-8      \u001b[46;2Har_LB ISO-8859-6  \u001b[47;153H\u001b[0;10;7m\u000f1,9            Top\u001b[48;3H\u001b[?25h"]
[0.152, "o", "\u001b[?25l\b\u001b[m\u000f \u001b[1;9Hu\u001b[9;51Hu\u001b[10;58Hu\u001b[13;21Hu\u001b[15;15Hupported locales is given in /u\u001b[16;15Hu\u001b[47;155H\u001b[0;10;7m\u000f1\u001b[48;2H\u001b[?25h"]
