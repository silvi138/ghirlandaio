6 I/O logs b\u001b[30m\u001b[103me\u001b[m\u000ffor\u001b[30m\u001b[103me\u001b[m\u000f r\u001b[30m\u001b[103me\u001b[m\u000fcycling th\u001b[30m\u001b[103me\u001b[37;5He\u001b[m\u000ft maxs\u001b[30m\u001b[103me\u001b[m\u000fq to a small\u001b[30m\u001b[103me\u001b[m\u000fr numb\u001b[30m\u001b[103me\u001b[m\u000fr if you don't hav\u001b[30m\u001b[103me\u001b[m\u000f unlimit\u001b[30m\u001b[103me\u001b[m\u000fd disk spac\u001b[30m\u001b[103me\u001b[38;4He\u001b[39;4He\u001b[m\u000ffaults!/usr/bin/sudor\u001b[30m\u001b[103me\u001b[40;4He\u001b[m\u000ffaults!/usr/local/bin/sudor\u001b[30m\u001b[103me\u001b[41;4He\u001b[42;4He\u001b[m\u000ffaults maxs\u001b[30m\u001b[103me\u001b[44;10He\u001b[m\u000fnt to disabl\u001b[30m\u001b[103me\u001b[m\u000f int\u001b[30m\u001b[103me\u001b[m\u000frc\u001b[30m\u001b[103me\u001b[m\u000fpt and log_subcmds for d\u001b[30m\u001b[103me\u001b[m\u000fbugg\u001b[30m\u001b[103me\u001b[45;8He\u001b[m\u000frs.  Oth\u001b[30m\u001b[103me\u001b[m\u000frwis\u001b[30m\u001b[103me\u001b[m\u000f, anything that us\u001b[30m\u001b[103me\u001b[m\u000fs ptrac\u001b[30m\u001b[103me\u001b[m\u000f(2) will b\u001b[30m\u001b[103me\u001b[m\u000f unabl\u001b[30m\u001b[103me\u001b[46;14He\u001b[m\u000fr sudo if int\u001b[30m\u001b[103me\u001b[m\u000frc\u001b[30m\u001b[103me\u001b[m\u000fpt_typ\u001b[30m\u001b[103me\u001b[m\u000f is s\u001b[30m\u001b[103me\u001b[m\u000ft to \"trac\u001b[30m\u001b[103me\u001b[47;158H\u001b[0;10;7m\u000f4\u001b[48;3H\u001b[?25h"]
