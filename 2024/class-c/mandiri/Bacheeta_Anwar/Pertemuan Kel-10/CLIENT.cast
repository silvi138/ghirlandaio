[0.005, "o", "\u001b[1;46r\u001b[H\u001b[35M\u001b[1;48r\u001b[2;5Het\u001b[11;44Het\r\n# Defaults!DEBUGGERS !intercept, !log_subcmds\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable intercept and log_subcmds for package managers.\u001b[K\r\n## Some package scripts run a huge number of commands, which is made\u001b[K\r\n## slower by these options and also can clutter up the logs.\u001b[K\r\n# Defaults!PKGMAN !intercept, !log_subcmds\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable PAM silent mode.  Otherwise messages by PAM\u001b[K\r\n## modules such as pam_faillock will not be printed.\u001b[K\r\n# Defaults !pam_silent\u001b[K\r\n\u001b[K\n##\u001b[K\r\n## Runas alias specification\u001b[K\r\n##\u001b[K\r\n\u001b[K\n##\u001b[K\r\n## User privilege specification\u001b[K\r\n##\u001b[K\r\n\u001b[92mroot\u001b[m\u000f \u001b[96mALL\u001b[m\u000f=(\u001b[96mALL\u001b[m\u000f:\u001b[96mALL\u001b[m\u000f) \u001b[96mALL\u001b[m\u000f\u001b[K\r\n\u001b[K\n## Uncomment to allow members of group wheel to execute any command\u001b[K\r\n# %wheel ALL=(ALL:ALL) ALL\u001b[K\r\n\u001b[K\n## Same thing without a password\u001b[K\r\n# %wheel ALL=(ALL:ALL) NOPASSWD: ALL\u001b[K\r\n\u001b[K\n## Uncomment to allow members of group sudo to execute any command\u001b[K\r\n# %sudo ALL=(ALL:ALL) ALL\u001b[K\r\n\u001b[K\n## Uncomment to allow any user to run sudo if they know the password\u001b[K\r\n## of the user they are running the command as (root by default).\u001b[K\r\n# Defaults targetpw  # Ask for the password of the target user\u001b[K\r\n# ALL ALL=(ALL:ALL) ALL  # WARNING: only use this together with 'Defaults targetpw'\u001b[K\r\n\u001b[K\n## Read drop-in files from /\u001b[30m\u001b[103metc\u001b[m\u000f/sudoers.d\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f38,29         98\u001b[48;5H\u001b[?25h"]
