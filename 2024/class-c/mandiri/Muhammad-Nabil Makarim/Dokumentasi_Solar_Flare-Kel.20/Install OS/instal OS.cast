[0.001, "o", "  \u001b[1m\u001b[34m->\u001b[m\u000f \u001b[1m-k /boot/kernel/vmlinuz-linux-lts -c /etc/mkinitcpio.d/default.conf -U /boot/efi/linux/arch-linux-lts.efi\u001b[m\u000f\r\n"]
[0.014, "o", "==> ERROR: Invalid option -c -- '/etc/mkinitcpio.d/default.conf' must be readable\r\n"]
[0.002, "o", "\u001b[?2004h[root@blackbird /]# "]
